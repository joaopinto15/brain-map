    {
      "type": "text",
      "id": "model_ids_note",
      "x": 770,
      "y": 830,
      "width": 520,
      "height": 56,
      "text": "a node id is a note's path, or a __vault__ / __dir__ prefixed key.\nNodeId::node_id builds those two prefixes and nothing else does,\nand is_structural(id) is the one place that reads them back",
      "originalText": "a node id is a note's path, or a __vault__ / __dir__ prefixed key.\nNodeId::node_id builds those two prefixes and nothing else does,\nand is_structural(id) is the one place that reads them back",
