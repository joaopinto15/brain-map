      "x": 786,
      "y": 334,
      "width": 492,
      "height": 90,
      "text": "pub struct Graph {\n    vault:  String,\n    groups: Vec<Group>,   // legend order is palette index\n    nodes:  Vec<Node>,    // id, label, group, tags, icon\n    links:  Vec<Link>,    // s, t: node indices\n}",
