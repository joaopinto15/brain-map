    {
      "type": "text",
      "id": "code_source_text",
      "x": 786,
      "y": 514,
      "width": 492,
      "height": 172,
      "text": "pub trait Source {\n    fn scan(&self, vault: &Path) -> Graph;         // /graph.json\n    fn fingerprint(&self, vault: &Path) -> u64;    // /changed\n    fn read_note(&self, v: &Path, rel: &str);      // /note\n    fn edit(&self, vault: &Path, rel: &str);       // /edit\n    fn choose_folder(&self);                       // /browse\n    fn open_vault(&self, typed: &str);             // /open\n    fn drives(&self) -> Vec<String>;               // never a route\n}",
      "originalText": "pub trait Source {\n    fn scan(&self, vault: &Path) -> Graph;         // /graph.json\n    fn fingerprint(&self, vault: &Path) -> u64;    // /changed\n    fn read_note(&self, v: &Path, rel: &str);      // /note\n    fn edit(&self, vault: &Path, rel: &str);       // /edit\n    fn choose_folder(&self);                       // /browse\n    fn open_vault(&self, typed: &str);             // /open\n    fn drives(&self) -> Vec<String>;               // never a route\n}",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
