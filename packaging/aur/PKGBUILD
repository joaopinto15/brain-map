# Maintainer: João Pinto <pintojad03@gmail.com>
#
# The source of truth for the AUR `brain-map-bin` package. `pkgver` and `sha256sums` are
# placeholders here; the release workflow stamps both and attaches the finished PKGBUILD
# to the GitHub release, which is what gets committed to the AUR repository.

pkgname=brain-map-bin
_pkgname=brain-map
pkgver=0.0.0
pkgrel=1
pkgdesc="Turns a folder of markdown notes into an interactive knowledge graph"
arch=('x86_64')
url="https://github.com/joaopinto15/brain-map"
license=('MIT')
# The window draws itself, so there is no browser engine here: this is what it opens
# with — the display protocols, the keyboard map, and GL.
# noto-fonts-emoji is where the icons come from: the window reads the colour bitmaps
# out of it directly, so without it every icon is a grey outline.
depends=('noto-fonts-emoji' 'libglvnd' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi')
optdepends=(
  'zenity: folder dialog for the vault picker'
  'kdialog: folder dialog for the vault picker, on KDE'
  'xdg-utils: open a link in a note in your browser'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$_pkgname/README.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
